{
  "uid": "cinemahub-app", "title": "CinemaHub App", "schemaVersion": 39, "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    { "id": 1, "type": "stat", "title": "Targets up", "gridPos": {"x":0,"y":0,"w":4,"h":4},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [{"refId":"A","expr":"sum(up)"}] },
    { "id": 2, "type": "stat", "title": "5xx rate (5m)", "gridPos": {"x":4,"y":0,"w":4,"h":4},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "fieldConfig": {"defaults": {"unit":"percentunit"}, "overrides": []},
      "targets": [{"refId":"A","expr":"sum(rate(http_request_duration_seconds_count{status=~\"5..\"}[5m])) / sum(rate(http_request_duration_seconds_count[5m]))"}] },
    { "id": 3, "type": "timeseries", "title": "Requests per second", "gridPos": {"x":8,"y":0,"w":16,"h":8},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "fieldConfig": {"defaults": {"unit":"reqps"}, "overrides": []},
      "targets": [{"refId":"A","expr":"sum(rate(http_request_duration_seconds_count[1m]))","legendFormat":"TPS"}] },
    { "id": 4, "type": "timeseries", "title": "Latency p95 / p99", "gridPos": {"x":0,"y":8,"w":12,"h":8},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "fieldConfig": {"defaults": {"unit":"s"}, "overrides": []},
      "targets": [
        {"refId":"A","expr":"histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))","legendFormat":"p95"},
        {"refId":"B","expr":"histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))","legendFormat":"p99"}] },
    { "id": 5, "type": "timeseries", "title": "4xx / 5xx by route", "gridPos": {"x":12,"y":8,"w":12,"h":8},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [{"refId":"A","expr":"sum by (route,status) (rate(http_request_duration_seconds_count{status=~\"[45]..\"}[5m]))","legendFormat":"{{route}} {{status}}"}] },
    { "id": 6, "type": "timeseries", "title": "Event loop lag p99", "gridPos": {"x":0,"y":16,"w":8,"h":7},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "fieldConfig": {"defaults": {"unit":"s"}, "overrides": []},
      "targets": [{"refId":"A","expr":"nodejs_eventloop_lag_p99_seconds","legendFormat":"lag p99"}] },
    { "id": 7, "type": "timeseries", "title": "Node heap used", "gridPos": {"x":8,"y":16,"w":8,"h":7},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "fieldConfig": {"defaults": {"unit":"bytes"}, "overrides": []},
      "targets": [{"refId":"A","expr":"nodejs_heap_size_used_bytes","legendFormat":"used"},{"refId":"B","expr":"nodejs_heap_size_total_bytes","legendFormat":"total"}] },
    { "id": 8, "type": "timeseries", "title": "Postgres pool", "gridPos": {"x":16,"y":16,"w":8,"h":7},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [{"refId":"A","expr":"pg_pool_connections","legendFormat":"{{state}}"}] },
    { "id": 9, "type": "timeseries", "title": "Queue jobs by state", "gridPos": {"x":0,"y":23,"w":12,"h":7},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [{"refId":"A","expr":"bullmq_jobs{state=~\"waiting|failed|active\"}","legendFormat":"{{queue}} {{state}}"}] },
    { "id": 10, "type": "timeseries", "title": "Oldest waiting job age", "gridPos": {"x":12,"y":23,"w":12,"h":7},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "fieldConfig": {"defaults": {"unit":"s"}, "overrides": []},
      "targets": [{"refId":"A","expr":"queue_oldest_waiting_age_seconds","legendFormat":"{{queue}}"}] },
    { "id": 11, "type": "logs", "title": "App logs", "gridPos": {"x":0,"y":30,"w":24,"h":10},
      "datasource": {"type":"loki","uid":"loki"},
      "targets": [{"refId":"A","expr":"{container=~\".*ticket-backend.*\"}"}] }
  ]
}

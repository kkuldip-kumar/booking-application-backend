{
  "compilerOptions": {
    "module": "commonjs", "target": "ES2022", "outDir": "./dist", "baseUrl": "./",
    "declaration": false, "removeComments": true, "emitDecoratorMetadata": true,
    "experimentalDecorators": true, "allowSyntheticDefaultImports": true, "esModuleInterop": true,
    "sourceMap": true, "incremental": true, "skipLibCheck": true,
    "strict": true, "noImplicitOverride": true, "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "test", "scripts"]
}
